# ============================================================================
#  Copy to `.env` for local dev. In PRODUCTION do NOT ship a .env file — set
#  these as real environment variables / platform secrets. When APP_ENV is
#  production|staging|prod|release the app FAILS TO START unless:
#    - SECRET_KEY is a strong random value (no "change-me"/"dev-*" markers, >=32 chars)
#    - COOKIE_SECURE=true
#    - CORS_ORIGINS contains the real https:// frontend origin (no "*")
#    - DATABASE_URL is a hosted Postgres URL (not @localhost, no "change-me")
#  Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# --- Application ---
APP_NAME=Faculty Patent Collection Portal
APP_ENV=development              # development | staging | production
SECRET_KEY=change-me-in-production   # <-- prod: 48+ random chars. Signs the JWT + CSRF. (JWT_SECRET below is unused.)
DEBUG=false                     # prod: false
API_PREFIX=/api
# Local dev origins (explicit list — must match the dev server origin exactly,
# including host AND port). Vite is pinned to port 5173 with strictPort: true
# (frontend/vite.config.ts), so it fails loudly instead of silently moving to
# :5174 and causing a CORS preflight 400 ("Disallowed CORS origin"). :4173 is
# the `vite preview` port. Both localhost and 127.0.0.1 forms are listed
# because browsers treat them as different origins.
# prod: replace with the real https:// frontend origin(s), comma-separated, no "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Database ---
# Local dev:
#   DATABASE_URL=postgresql+asyncpg://faculty_user:change-me@localhost:5432/faculty_portal
# Neon / managed Postgres (TLS required). Keep the +asyncpg driver; libpq query
# params (sslmode, channel_binding) are fine to leave in - app/core/database.py
# strips them for asyncpg and enforces ssl per-driver. Never commit the real value.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth / Session ---
# NOTE: JWT_SECRET is NOT read by the app - tokens are signed with SECRET_KEY above.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false              # prod: true (HTTPS required)
COOKIE_SAMESITE=lax             # prod: "none" if the frontend is on a different domain than the API (requires COOKIE_SECURE=true)

# --- Upload / Storage ---
STORAGE_BACKEND=local            # local | s3
LOCAL_STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=20971520        # 20 MB
MAX_PDF_PAGES=50
MAX_IMAGE_DIMENSION=10000
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg
CLAMAV_HOST=                     # empty = disabled

# --- Local OCR (Tesseract - primary local engine for scanned/image docs) ---
# Leave TESSERACT_CMD blank to auto-detect (PATH + common install dirs). Set it
# to an explicit path if Tesseract is installed somewhere non-standard, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
TESSERACT_LANGS=eng

# --- OCR.Space (OPTIONAL external emergency fallback; NOT required) ---
# The pipeline is local-first (PyMuPDF text -> PaddleOCR -> Tesseract). OCR.Space
# is only consulted when every local engine yields no text AND this is enabled.
# Set OCRSPACE_FALLBACK_ENABLED=false (or leave OCRSPACE_API_KEY empty) to run
# fully offline.
OCRSPACE_FALLBACK_ENABLED=true
OCRSPACE_API_KEY=
OCRSPACE_API_URL=https://api.ocr.space/parse/image
OCRSPACE_LANGUAGE=eng
OCRSPACE_OCR_ENGINE=2
OCRSPACE_TIMEOUT_SECONDS=30
# Retry / backoff for HTTP 429 and transient failures (linear backoff * attempt).
OCRSPACE_MAX_RETRIES=3
OCRSPACE_BACKOFF_SECONDS=2.0

# --- Verification ---
VERIFICATION_TIMEOUT_SECONDS=10
VERIFICATION_RETRIES=2
VERIFICATION_CACHE_TTL_SECONDS=86400
VERIFICATION_DEFAULT_COUNTRY=IN

# --- Indian Patent Office lookup (IPO / InPASS) ---
# No official free API exists. Point this at the InPASS public-search JSON
# backend or a small self-hosted proxy that returns one record per number.
# Leave IPINDIA_SEARCH_URL blank to keep it disabled (degrades to manual).
IPINDIA_ENABLED=false
IPINDIA_SEARCH_URL=
IPINDIA_TIMEOUT_SECONDS=15

# --- Optional LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Rate Limiting ---
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_UPLOAD_PER_HOUR=50
RATE_LIMIT_SEARCH_PER_MINUTE=30
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_SECONDS=900