# Frontend production build configuration.
# Copy to `frontend/.env.production` (gitignored) or set VITE_API_BASE_URL in the
# hosting platform's build environment. It is baked into the static bundle at
# `npm run build` time — there is no runtime config.
#
# Must be the PUBLIC https URL of the backend API, including the /api/v1 prefix.
VITE_API_BASE_URL=https://your-backend.example/api/v1
